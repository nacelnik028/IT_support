extends "res://tests/service_missions_ui.gd"

func run():
	capture_directory = "res://docs/ui-review/2026-11-12-service-missions/"
	shell = load("res://scenes/world/Game.tscn").instantiate()
	root.add_child(shell)
	await frames()
	shell.ui.save_preference("introduction_seen",true)
	shell.ui.save_preference("vsync",false)
	shell.enter_world("Počítačové sítě")
	shell.world.player.position = Vector3(5.7,0.02,-30.2)
	await frames()
	var game = shell.ui.game
	var s = game.network_workshop
	shell.open_network_workshop("home")
	await use_button("Obměněné zadání")
	await use_button("A / PC 04 bez linky")
	var seed_value: int = s.variant_seed
	var initial: Dictionary = s.network.snapshot()
	check(seed_value>0,"Explicit varied assignment generates seed once")
	await capture("variant-ticket")
	await use_button("Opravy")
	await use_button("Obnovit výchozí stav pokusu")
	await use_button("Zachovat rozpracovaný pokus")
	check(s.network.snapshot()==initial,"Cancel reset preserves variant")
	await use_button("Obnovit výchozí stav pokusu")
	await use_button("Potvrdit obnovení pokusu")
	check(s.variant_seed==seed_value and s.network.snapshot()==initial,"UI reset restores same variant")
	await use_button("Odevzdat ticket")
	await use_button("Historie")
	await use_button("A / Procvičování / Nesplněno / 0 bodů")
	await use_button("Zopakovat tuto variantu")
	check(s.variant_seed==seed_value and s.network.snapshot()==initial,"Exact variant replay from stored history")
	s.edit("tcp",false)
	var changed: Dictionary = s.network.snapshot()
	await use_button("Historie")
	await use_button("A / Procvičování / Nesplněno / 0 bodů")
	await use_button("Zopakovat tuto variantu")
	await use_button("Zachovat současný pokus")
	check(s.network.snapshot()==changed,"Replay confirmation cancellation preserves work")
	await use_button("Historie")
	await use_button("A / Procvičování / Nesplněno / 0 bodů")
	await use_button("Zopakovat tuto variantu")
	await use_button("Potvrdit nový pokus")
	check(s.variant_seed==seed_value and s.network.snapshot()==initial,"Confirmed replay restores exact assignment")
	await use_button("Výběr ticketů")
	await use_button("Volný trénink")
	check(button("Zahájit misi / Firemní portál po změně sítě").disabled,"Free workshop never silently starts a graded mission")
	await use_button("Zkouška")
	await use_button("Zahájit misi / Firemní portál po změně sítě")
	var service = game.service_missions
	await use_button("Python / analyzovat virtuální data incidentu")
	shell.code_editor.editor.grab_focus()
	shell.code_editor.editor.select_all()
	var source := "print('saved incident draft')\n"
	shell.code_editor.editor.insert_text_at_caret(source)
	await frames()
	await use_button("Zpět k incidentu")
	var attempt: String = service.attempt_id
	await use_button("Odložit celou servisní misi")
	check(not service.active and service.data.drafts["SERVICE-PORTAL"].program.files["main.py"]==source,"UI suspension saves whole incident and code")
	await capture("mission-parked")
	await use_button("Historie")
	check(not shell.overlay.find_children("*","Button",true,false).any(func(b): return b.is_visible_in_tree() and b.text=="Zopakovat tuto variantu"),"Parked exam does not expose history solutions")
	await use_button("Výběr ticketů")
	await use_button("Pokračovat v misi / Firemní portál po změně sítě / Zkouška")
	check(service.active and service.session.mode=="exam" and service.attempt_id==attempt and service.programming.files["main.py"]==source,"UI resume preserves exact exam and code")
	await use_button("Výběr ticketů")
	await use_button("Restart celé mise / Firemní portál po změně sítě")
	await use_button("Zachovat servisní misi")
	check(service.attempt_id==attempt and service.programming.files["main.py"]==source,"Cancel restart preserves whole mission")
	await use_button("Restart celé mise / Firemní portál po změně sítě")
	await use_button("Potvrdit restart celé mise")
	check(service.attempt_id!=attempt and service.programming.files["main.py"]==service.starter() and service.session.mode=="exam","Confirmed restart restores whole mission")
	attempt = service.attempt_id
	await use_button("Opravy")
	await use_button("Obnovit výchozí stav pokusu")
	await use_button("Potvrdit obnovení pokusu")
	check(service.attempt_id!=attempt and service.session.variant_seed==1,"Workshop reset means whole active mission")
	var original_path: String = Saves.path_override
	Saves.path_override = "user://missing-service-ui-"+str(OS.get_process_id())+"/save.json"
	game.save()
	shell.open_network_workshop("ticket")
	await frames()
	check(game.unsaved,"Actual save failure visible in mission")
	Saves.path_override = original_path
	await use_button("Zkusit uložit znovu")
	check(not game.unsaved and service.data.history.is_empty(),"Retry is available and never submits mission")
	var audio_ref: WeakRef = weakref(shell.service_audio)
	shell.queue_free()
	await frames()
	# Let the audio mixer release its queued playback references at its own
	# block boundary; fast headless process frames do not advance that thread.
	await create_timer(0.12).timeout
	check(audio_ref.get_ref()==null,"Continuation scene releases its spatial audio owner")
	print("SERVICE CONTINUATION UI: %d checks, %d failures" % [checks,failures])
	quit(1 if failures else 0)
