extends "res://tests/network_workshop.gd"

func run():
	capture_directory = "res://docs/ui-review/2026-11-12-service-missions/"
	shell = load("res://scenes/world/Game.tscn").instantiate()
	root.add_child(shell)
	await frames()
	shell.ui.save_preference("introduction_seen",true)
	shell.enter_world("Počítačové sítě")
	shell.world.player.position = Vector3(6.6,0.02,-30.3)
	await frames()
	var s = shell.ui.game.network_workshop
	s.mode = "practice"
	s.start("A",1)
	await aim_pc("work:tester")
	check(s.tester.held,"PC ray/interact takes tester")
	var route: Dictionary = s.network.ports.duplicate()
	shell.world.player.position = Vector3(1.15,0.02,-33.4)
	await aim_pc("work:pc04")
	check(s.tester.source=="pc04" and s.network.cable=="","Tester selects probe without rewiring")
	shell.world.player.position = Vector3(1.6,0.02,-31.5)
	await aim_pc("work:4")
	await aim_pc("work:4")
	check(s.tester.result.get("state")=="unavailable" and s.network.measurements.link.passed==false,"Actual unavailable port")
	check(s.network.ports==route,"Measuring does not alter wiring")
	s.tester.port = 6
	s.tester.measure(s.network)
	check(s.tester.result.state=="wrong_endpoint","Wrong endpoints rejected")
	s.unplug("pc04")
	s.tester.measure(s.network)
	check(s.tester.result.state=="open","Disconnected actual route")
	s.select_cable("pc04")
	s.connect_port(6)
	check(s.tester.display(s.network).contains("ZASTARALÉ"),"Display detects configuration change")
	s.tester.measure(s.network)
	check(s.tester.result.passed and s.network.fresh("link"),"Tester credits same link evidence as panel")
	s.vlan(6,20)
	check(not s.network.fresh("link"),"Prior evidence stale")
	s.tester.measure(s.network)
	check(s.tester.result.passed,"Continuity cannot diagnose VLAN")
	shell.open_network_workshop("tester")
	await frames()
	await click(button("Vrátit tester"))
	await click(button("Vzít tester"))
	await click(button("Tester / PC 04"))
	await click(button("Tester → SW 06"))
	await click(button("Spustit měření testeru"))
	check(s.tester.result.passed,"Functional panel alternative")
	await capture("tester-panel")
	await escape()
	shell.world.player.camera.look_at(Vector3(0.6,1.5,-31.5))
	await capture("tester-carried")
	shell.world.player.position = Vector3(8,0.02,-27)
	await frames()
	check(not s.tester.held and shell.world.network_room.workshop.tester_visual.get_parent()==shell.world.network_room.workshop,"Leaving room returns single instrument home")
	shell.world.player.position = Vector3(6.6,0.02,-30.3)
	await frames()
	s.mode = "exam"
	await prepare_xr()
	for hand_index in [0,1]:
		var hand_node = rig.left if hand_index==0 else rig.right
		# Registered grip pose, short ray, and the actual pressed/released path.
		var target = shell.world.network_room.workshop.targets.tester
		var pose := Transform3D(Basis.IDENTITY,target.global_position+Vector3(0,0,0.35))
		trackers[hand_index+1].set_pose("grip",rig.global_transform.affine_inverse()*pose,Vector3.ZERO,Vector3.ZERO,XRPose.XR_TRACKING_CONFIDENCE_HIGH)
		for tick in 3: await physics_frame
		rig.pressed(hand_node,"grip_click")
		check(s.tester.held and s.tester.hand!=null and s.tester.hand.get_ref()==rig.grip_nodes[hand_node],"XR grip holds tester / "+str(hand_index))
		await frames()
		check(shell.world.network_room.workshop.tester_visual.global_position.distance_to(rig.grip_nodes[hand_node].global_position)<0.25,"Instrument mounts at actual grip pose")
		rig.released(rig.right if hand_index==0 else rig.left,"grip_click")
		check(s.tester.hand!=null and s.tester.hand.get_ref()==rig.grip_nodes[hand_node],"Other hand release does not detach held instrument")
		rig.released(hand_node,"grip_click")
		check(s.tester.held and s.tester.hand==null,"XR release keeps tool available at waist / "+str(hand_index))
		for tick in 3: await physics_frame
		check(shell.world.network_room.workshop.tester_visual.global_position.distance_to(rig.head.global_position)<0.8,"Released tester follows XR user viewpoint")
		shell.open_network_workshop("tester")
		await frames()
		await click(button("Tester / PC 04"),hand_index)
		await click(button("Tester → SW 06"),hand_index)
		await click(button("Spustit měření testeru"),hand_index)
		check(s.tester.result.passed and s.hints==0,"XR measurement is no hint in exam")
		await capture("tester-vr-"+str(hand_index),rig.monitor.viewport)
		await escape()
		s.tester.put_back()
		await frames()
	rig.teleport_to(Vector3(4,0,-14))
	await frames()
	check(not s.tester.held and s.task.is_empty(),"Teleport safely ends temporary workshop")
	rig.deactivate()
	shell.vr_active = false
	for tracker in trackers: XRServer.remove_tracker(tracker)
	shell.queue_free()
	await frames()
	print("CABLE TESTER: %d checks, %d failures; PC and synthetic XR" % [checks,failures])
	quit(1 if failures else 0)
