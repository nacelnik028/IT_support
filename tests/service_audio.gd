extends "res://tests/network_workshop.gd"

func ticks(count_value: int):
	for tick in count_value: await physics_frame

func run():
	capture_directory = "res://docs/ui-review/2026-11-12-service-missions/"
	shell = load("res://scenes/world/Game.tscn").instantiate()
	root.add_child(shell)
	await frames()
	shell.ui.save_preference("introduction_seen",true)
	shell.enter_world("Hlavní serverovna")
	var audio = shell.service_audio
	for key in audio.streams:
		var stream = audio.streams[key]
		check(stream is AudioStreamWAV and stream.get_length()>0.05,"Loaded actual sound "+key)
		var playback = stream.instantiate_playback()
		playback.start()
		var nonzero := false
		for sample in playback.mix_audio(1.0,2048):
			if absf(sample.x)>0.0001: nonzero = true
		check(nonzero,"Decoded nonzero PCM "+key)
		playback.stop()
	await ticks(4)
	check(audio.racks.size()==4 and audio.effects.size()==4 and audio.doors.size()==3,"Bounded shared spatial sources")
	check(audio.racks["NAS-01"].playing,"Powered rack actually playing")
	shell.ui.game.main_sim.state.hosts["NAS-01"].online = false
	await ticks(45)
	check(not audio.racks["NAS-01"].playing,"Power state fades/stops rack")
	shell.ui.game.main_sim.state.hosts["NAS-01"].online = true
	await ticks(4)
	check(audio.racks["NAS-01"].playing,"Powered rack resumes")
	var start_count := int(audio.played.get("step",0))
	shell.world.player.position = Vector3(1,0.02,4.8)
	await walk_to(Vector3(3,0.02,4.8))
	check(int(audio.played.get("step",0))>start_count,"Actual grounded walking produces steps")
	start_count = int(audio.played.get("step",0))
	shell.world.player.position = Vector3(-7,0.02,3)
	await ticks(10)
	check(int(audio.played.get("step",0))==start_count,"Teleport and standing produce no steps")
	shell.pause_menu()
	Input.action_press("walk_forward")
	await ticks(20)
	Input.action_release("walk_forward")
	check(int(audio.played.get("step",0))==start_count,"Open UI produces no steps")
	check(not audio.racks["NAS-01"].playing and audio.effects.all(func(source): return not source.playing),"Pause silences sources")
	shell.return_to_world()
	shell.world.player.position = Vector3(0,0.02,4)
	var door_count := int(audio.played.get("door",0))
	check(shell.world.toggle_door(),"Door begins moving")
	await ticks(20)
	check(int(audio.played.get("door",0))>door_count,"Actual door movement sounds")
	await ticks(40)
	shell.world.player.position = Vector3(9,0.02,3.5)
	door_count = int(audio.played.get("door",0))
	check(not shell.world.toggle_door(),"Occupied door operation rejected")
	await ticks(5)
	check(int(audio.played.get("door",0))==door_count,"Rejected door operation silent")
	shell.enter_world("Počítačové sítě")
	shell.world.player.position = Vector3(5.7,0.02,-30.2)
	await ticks(3)
	var s = shell.ui.game.network_workshop
	s.start("A")
	var cable_count := int(audio.played.get("cable_on",0))
	s.select_cable("pc04")
	s.connect_port(3)
	check(int(audio.played.get("cable_on",0))==cable_count,"Occupied port produces no successful-connect sound")
	s.connect_port(6)
	check(int(audio.played.get("cable_on",0))==cable_count+1,"Actual connection sounds once")
	s.unplug("pc04")
	check(int(audio.played.get("cable_off",0))==1,"Actual disconnection sounds")
	s.tester.take()
	s.tester.source = "pc04"
	s.tester.port = 6
	s.measure_tester()
	check(int(audio.played.get("tester",0))==1,"Tester responds to real failed measurement too")
	check(audio.effects.any(func(source): return source.playing),"Actual spatial voice playing")
	shell.ui.save_preference("environment_volume",0.2)
	shell.ui.save_preference("effects_volume",0.4)
	await ticks(3)
	check(is_equal_approx(db_to_linear(AudioServer.get_bus_volume_db(AudioServer.get_bus_index("Environment"))),0.2),"Environment level")
	check(is_equal_approx(db_to_linear(AudioServer.get_bus_volume_db(AudioServer.get_bus_index("Effects"))),0.4),"Effects level")
	shell.ui.save_preference("muted",true)
	check(AudioServer.is_bus_mute(0),"Master mute preserved")
	shell.ui.save_preference("muted",false)
	shell.enter_world("English in London")
	var english = shell.ui.game.english
	english.start("LON01","learn",0)
	shell.open_english()
	var line: Dictionary = shell.speech.mapping.lines[0]
	check(shell.speech.speak(line.text,line.speaker) and shell.speech.playing,"Existing London speech actually plays")
	await ticks(18)
	check(audio.duck<0.5,"Ambient/effect ducking during speech")
	shell.speech.stop_speech()
	audio._notification(MainLoop.NOTIFICATION_APPLICATION_FOCUS_OUT)
	await ticks(3)
	check(not audio.active() and audio.racks.values().all(func(source): return not source.playing),"Focus loss silences")
	audio._notification(MainLoop.NOTIFICATION_APPLICATION_FOCUS_IN)
	shell.enter_world("Hlavní serverovna")
	shell.ui.game.start_mission(0,true)
	var disk_count := int(audio.played.get("disk",0))
	shell.ui.game.apply("physical_spare",{"spare":"SPARE-2T"})
	check(int(audio.played.get("disk",0))==disk_count+1,"Actual disk pickup sounds")
	shell.ui.game.apply("physical_spare",{"spare":"SPARE-2T"})
	check(int(audio.played.get("disk",0))==disk_count+1,"Rejected disk pickup silent")
	shell.ui.game.apply("physical_return_spare",{})
	shell.ui.game.sim.reset({"disks":{"2":{"health":"Failed"}},"raid":{"health":"Degraded"}})
	disk_count = int(audio.played.get("disk",0))
	check(shell.ui.game.apply("physical_remove",{"pool":"RAID","slot":"2","serial":"DC-002","backup_checked":true,"confirmed":true}).ok,"Actual disk removed")
	shell.ui.game.apply("physical_spare",{"spare":"SPARE-2T"})
	check(shell.ui.game.apply("physical_insert",{"pool":"RAID","slot":"2","backup_checked":true}).ok,"Actual disk inserted")
	check(int(audio.played.get("disk",0))==disk_count+3,"Removal, handling and insertion each sound")
	var off_count := int(audio.played.get("cable_off",0))
	shell.ui.game.apply("physical_cable",{"device":"PVE-01","connected":false,"port":1})
	check(int(audio.played.get("cable_off",0))==off_count+1,"Real server cable disconnect sounds")
	shell.ui.game.apply("physical_cable",{"device":"PVE-01","connected":false,"port":8})
	check(int(audio.played.get("cable_off",0))==off_count+1,"Changing cached port of an already unplugged lead is silent")
	shell.set_mode("menu")
	await ticks(3)
	check(audio.racks.values().all(func(source): return not source.playing) and audio.effects.all(func(source): return not source.playing),"Menu has no lingering sound")
	var weak_audio: WeakRef = weakref(audio)
	shell.queue_free()
	await frames()
	check(weak_audio.get_ref()==null,"Scene cleanup releases all sources")
	print("SERVICE AUDIO: %d checks, %d failures; nonzero PCM and actual players, no claimed human listening" % [checks,failures])
	quit(1 if failures else 0)
