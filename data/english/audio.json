      "id": "LONA01",
      "scenario": "LON01",
      "speaker": "customer",
      "text": "What ticket options are available for this afternoon?",
      "normal": "res://assets/audio/london/LONA01-normal.mp3",
      "normal_sha256": "b7f95355b75f451a61286508500694f3a637a2bdac794c93a7ed6290de32e98a",
